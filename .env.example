# Copy this file to .env and fill in your key. Never commit .env.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model: a Flash model (fast, cheap, free tier available).
# gemini-3.8-flash is newer, but its free tier allows only 20 requests/day.
GEMINI_MODEL=gemini-3.6-flash

# Simulated "now" for the store (ISO format, America/Campo_Grande time).
# The dataset is frozen in March 2026; this is a Wednesday during business
# hours, three days after the last order. Leave empty to use the real time.
STORE_NOW=2026-03-25T10:30
